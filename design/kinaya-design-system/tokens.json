{
  "name": "Kinaya OS",
  "primaryMode": "dark",
  "color": {
    "bg": { "base": "#141715", "surface": "#1C1F1D", "elevated": "#252825", "sunken": "#0F110F" },
    "fg": { "primary": "#F2EFE9", "secondary": "#A8A49B", "muted": "#6E6B64" },
    "border": { "default": "#2E312E", "strong": "#3D423D", "warm": "#4A3A2E" },
    "accent": { "default": "#E8552A", "hover": "#FF6A3D", "muted": "rgba(232,85,42,0.14)", "ring": "rgba(232,85,42,0.18)", "fg": "#1A1300" },
    "state": {
      "paid": "#6B8F5E", "due": "#C9922E", "late": "#B4472E",
      "paidBg": "rgba(107,143,94,0.16)", "dueBg": "rgba(201,146,46,0.16)", "lateBg": "rgba(180,71,46,0.16)", "neutralBg": "rgba(168,164,155,0.12)"
    },
    "division": {
      "studio": "#5C7A8A", "atelier": "#8A8455", "label": "#8A5C74", "general": "#5F7A66",
      "studioFaint": "rgba(92,122,138,0.22)", "atelierFaint": "rgba(138,132,85,0.22)", "labelFaint": "rgba(138,92,116,0.22)", "generalFaint": "rgba(95,122,102,0.22)"
    },
    "light": {
      "bg": { "base": "#F2EFE9", "surface": "#FBFAF6", "elevated": "#F0ECE3", "sunken": "#E8E3D8" },
      "fg": { "primary": "#1A1D1A", "secondary": "#5A574F", "muted": "#8A867C" },
      "border": { "default": "#DAD5C8", "strong": "#C4BEAC", "warm": "#C9A688" },
      "accent": { "default": "#D6491F", "hover": "#B03A18", "fg": "#FBFAF6" }
    }
  },
  "font": {
    "serif": "'Spectral', Georgia, serif",
    "sans": "'Archivo', system-ui, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "fontSize": { "48": "48px", "32": "32px", "24": "24px", "18": "18px", "15": "15px", "13": "13px", "11": "11px" },
  "lineHeight": { "serif": 1.45, "sans": 1.35 },
  "letterSpacing": { "tight": "-0.01em", "label": "0.04em" },
  "radius": { "sm": "6px", "md": "12px", "lg": "20px", "pill": "999px" },
  "space": { "grid": 4, "row": "40px" },
  "rules": {
    "linear": "Blocks are closed hairline frames with the base background inside and out — never filled surfaces.",
    "filledExceptions": ["primary button", "radial signature", "division badges"],
    "accent": "Vermillion only for primary action, active state and the \"today\" marker.",
    "typeContrast": "Spectral for voice (titles, project names, hero amounts, notes). Archivo for mechanics (tables, labels, dates, statuses).",
    "tables": "Horizontal hairlines only, no vertical grid. Amounts tabular-nums right-aligned. Codes in mono.",
    "timelines": "Pill bars tinted per division (never per project). Vermillion only for the dotted today line.",
    "brand": "No wordmark. Arabic comma ، is the anchor and recurring bullet/marker."
  }
}
