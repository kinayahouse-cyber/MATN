// Matn — schéma cible (Phase 2, MVP Mémoire)
// Consolidé depuis : docs/foundation/audit-reconciliation.md, ADR-006, ADR-007, ADR-008
// (docs/foundation/matn-livrable-10-adr-register.md), docs/foundation/plan-migration-adr006.md.
//
// Aucune donnée à migrer (confirmé 07/08, voir docs/foundation/dry-run-productionlabel.md) :
// ce fichier est le schéma à créer directement, pas une migration incrémentale.
//
// Entités Post-MVP volontairement absentes de ce fichier (ontologie, Livrable 03) :
// Opportunite, Facture, Paiement — module CRM/Finance, hors périmètre MVP Mémoire.
// ProductionLabel et SectionDossier n'existent plus : fusionnés dans Projet et Document (ADR-006 pt.2, ADR-008).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Transverse
// ---------------------------------------------------------------------------

enum Track {
  STUDIO
  ATELIER
  LABEL
}

// Track=GENERALITES de l'ancien schéma n'existe plus : devient Track=NULL (ADR-006 pt.3).

// ---------------------------------------------------------------------------
// Auth — mono-utilisateur pour l'instant (ADR-005), structuré pour accueillir plusieurs comptes.
// ---------------------------------------------------------------------------

// ADMIN voit tout ; COLLABORATEUR est restreint aux projets où il est membre (Projet.membres),
// et dans ces projets, seulement aux tâches et fichiers — pas de Finance, pas de CRM Client, pas
// de Décisions/Notes (Livrable 06, périmètre stratégique interne).
enum Role {
  ADMIN
  COLLABORATEUR
}

model Utilisateur {
  id        String   @id @default(cuid())
  email     String   @unique
  nom       String?
  // Défaut ADMIN : un compte existant qui n'a pas encore de rôle explicite garde l'accès complet
  // plutôt que d'être restreint silencieusement par cette migration.
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())

  tachesAssignees Tache[]
  projetsMembre   Projet[] @relation("ProjetMembres")

  @@map("utilisateurs")
}

// ---------------------------------------------------------------------------
// Client / Commercial
// ---------------------------------------------------------------------------

enum TypeOrganisation {
  CLIENT_DIRECT
  AGENCE
  PRESCRIPTEUR
}

// Catégories fixes plutôt que du texte libre — le secteur doit pouvoir être filtré/groupé sans
// que chaque saisie invente sa propre formulation ("Café de spécialité" vs "F&B" vs "Food").
enum SecteurClient {
  ARCHITECTURE
  MODE_BEAUTE
  FOOD_BEVERAGE
  TECH
  COMMUNICATION
  PRODUCTION
  CULTURE_EVENEMENTIEL
  IMMOBILIER
  INSTITUTIONNEL
  SANTE
  EDUCATION
  AUTRE
}

// Pipeline de prospection d'un Client, du premier contact au compte perdu/dormant.
enum EtatProspection {
  A_CONTACTER
  CONTACTE
  EN_DISCUSSION
  PROPOSITION_ENVOYEE
  CLIENT_ACTIF
  DORMANT
  PERDU
}

model Organisation {
  id      String           @id @default(cuid())
  nom     String
  type    TypeOrganisation @default(CLIENT_DIRECT)
  secteur SecteurClient?

  // Track dominant du Client (Business Ontology §2). Nullable : NULL transitoire tant que les
  // anomalies de backfill (Organisations à Track multiple, ADR-007 pt.7) ne sont pas résolues
  // manuellement ; NOT NULL visé ensuite, dans une migration de suivi distincte.
  track Track?

  // Identifiants légaux (Algérie)
  nif String?
  nis String?
  rc  String?
  ai  String?
  rib String?

  // État d'avancement commercial du Client — le `statut` (prospect/actif/dormant) prévu par
  // l'ontologie (Livrable 03 §2) et laissé de côté lors d'ADR-006/007, ajouté ici sous forme de
  // pipeline de prospection explicite.
  etatProspection EtatProspection @default(A_CONTACTER)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts  Contact[]
  projets   Projet[]
  decisions Decision[]
  notesMatn Note[]
  documents Document[]

  // NB : l'ontologie prévoit aussi une date de premier contact — écart noté dans l'audit de
  // réconciliation, jamais transformé en chantier de migration décidé. Volontairement absent.

  @@map("organisations")
}

enum CanalContact {
  EMAIL
  TELEPHONE
  WHATSAPP
  AUTRE
}

enum Registre {
  TU
  VOUS
}

model Contact {
  id             String        @id @default(cuid())
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  organisationId String?

  // Relation directe Contact<->Projet (ADR-006 pt.5) — table de jointure vide au départ,
  // peuplée au fil de l'eau, pas de pré-peuplement automatique (ADR-007 pt.5).
  projets Projet[] @relation("ContactProjets")

  nom       String
  role      String?
  canal     CanalContact @default(EMAIL)
  registre  Registre     @default(VOUS)
  email     String?
  telephone String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contacts")
}

// ---------------------------------------------------------------------------
// Projet — entité unifiée, y compris Track=Label (ADR-006 pt.2, ADR-008)
// ---------------------------------------------------------------------------

enum Engagement {
  LECTURE
  IDENTITE
  FILM
  EDITION
  CAPSULES
  MODULE_ATELIER
}

// Cycle commercial général (Studio/Atelier) — corrigé (ADR-009) pour correspondre au cycle
// décrit par l'ontologie (Livrable 03 §4) : Devis envoyé → Signé → En cours → Livré → Clos,
// Abandonné possible depuis n'importe quelle étape avant Signé. Les valeurs précédentes
// (Cadrage/Préprod/Production/Livraison/Clôture) avaient été reprises telles quelles de l'ancien
// schéma sans être réalignées sur ce cycle au moment d'ADR-006/007 — erreur corrigée ici.
enum StadeProjet {
  DEVIS_ENVOYE
  SIGNE
  EN_COURS
  LIVRE
  CLOS
  ABANDONNE
}

// Stade de production propre au monde Label (ADR-008) — coexiste avec StadeProjet plutôt que de
// le remplacer : les deux cycles (commercial général / production Label) ne se recouvrent pas.
enum StadeProductionLabel {
  DEVELOPPEMENT
  PREPROD
  PROD
  DISTRIBUTION
  ARCHIVE
}

model Projet {
  id   String @id @default(cuid())
  code String @unique // KIN-26-{S|A|L|G}-XXX

  nom         String
  description String?
  // Brief rédigé en blocs typés (h1/h2/h3/p1/p2/p3) — stocké tel quel :
  // [{ id, type, text }]. Distinct de `description`, qui reste le résumé court.
  brief       Json?
  track       Track?
  engagement  Engagement?
  stade       StadeProjet @default(DEVIS_ENVOYE)

  // `budget` = plafond facturable, suivi contre Document de type DEVIS.
  // `budgetInterne` = enveloppe d'investissement interne, non facturable (ADR-007 pt.2) —
  // pas de fusion entre les deux, même pour les Projets Track=Label.
  // `budgetEncaisse` = montant effectivement réglé par le client à date — saisi manuellement
  // (pas de rapprochement facture/paiement modélisé pour l'instant), distinct de `budget` (plafond)
  // et de la somme des Dépenses (coûts internes, pas des encaissements).
  budget         Decimal? @db.Decimal(14, 2)
  budgetInterne  Decimal? @db.Decimal(14, 2)
  budgetEncaisse Decimal? @db.Decimal(14, 2)

  // Champs structurés propres au monde Label, peuplés uniquement pour track=LABEL (ADR-008) —
  // remplacent le champ JSON temporaire envisagé par ADR-007 pt.3 (devenu sans objet).
  stadeLabel      StadeProductionLabel?
  format          String?
  statutDiffusion String?

  // Palier (P0-P4) : retiré du périmètre de cette migration, sémantique non documentée
  // (ADR-007 pt.6 ; question ouverte, Livrable 12 #07). Volontairement absent ici.

  dateDebut     DateTime?
  dateFinPrevue DateTime?

  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  organisationId String?

  contacts  Contact[]     @relation("ContactProjets")
  documents Document[]
  decisions Decision[]
  notesMatn Note[]
  assets    Asset[]
  taches    Tache[]
  depenses  Depense[]
  membres   Utilisateur[] @relation("ProjetMembres")

  // Portail client : lien magique, sans compte à créer côté client (Livrable 06 — accès externe
  // volontairement minimal pour un premier jet). Présence = portail actif ; régénérer le jeton
  // invalide l'ancien lien, le mettre à NULL désactive le portail sans perdre le reste.
  portailToken String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("projets")
}

// ---------------------------------------------------------------------------
// Document — entité générique (ex-Devis + ex-SectionDossier, ADR-006 pt.4, ADR-007 pt.1/pt.4)
// ---------------------------------------------------------------------------

enum TypeDocument {
  DEVIS
  FACTURE
  CONTRAT
  GUIDELINE
  LIVRABLE
  COMPTE_RENDU
}

enum StatutDocument {
  BROUILLON
  VALIDE
  ENVOYE
  SIGNE // terminal
  REFUSE // terminal — 5e statut, ADR-007 pt.1
}

model Document {
  id       String        @id @default(cuid())
  projet   Projet?       @relation(fields: [projetId], references: [id], onDelete: Cascade)
  projetId String?
  client   Organisation? @relation(fields: [clientId], references: [id])
  clientId String?

  type   TypeDocument
  numero String? // requis en pratique pour DEVIS/FACTURE ; optionnel pour les autres types
  objet  String? // description globale de l'objet du devis/facture, imprimée sous l'en-tête
  statut StatutDocument @default(BROUILLON)
  track  Track? // dénormalisé depuis Projet.track à la création
  url    String? // lien vers le fichier téléchargeable — pas de stockage propre à MATN pour
  // l'instant (pas d'intégration Supabase Storage) : un simple lien externe/partagé

  // Uniquement renseignés pour DEVIS/FACTURE — pilotent le calcul HT/TVA/TTC (src/lib/facturation.ts)
  // affiché sur l'éditeur et sur la page d'impression. NULL/0 = exonéré / sans remise.
  tauxTva   Decimal? @db.Decimal(5, 2)
  remisePct Decimal? @db.Decimal(5, 2)

  // Échéance de règlement d'une FACTURE (créance client). NULL = pas d'échéance fixée : la
  // facture apparaît quand même dans l'échéancier, simplement sans retard calculable.
  dateEcheance DateTime?

  lignes    LigneDocument[] // vide pour les types hors DEVIS/FACTURE
  paiements Paiement[]

  versionDe   Document?  @relation("DocumentVersions", fields: [versionDeId], references: [id])
  versionDeId String?
  versions    Document[] @relation("DocumentVersions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NB : `numero` doit être unique seulement quand renseigné — un index unique classique sur ce
  // champ rejetterait les multiples NULL. Nécessite un index unique PARTIEL
  // (CREATE UNIQUE INDEX ... WHERE numero IS NOT NULL), non exprimable dans le DSL Prisma :
  // à ajouter en SQL brut après `prisma migrate dev` (migration éditée manuellement).

  @@map("documents")
}

// Encaissement réel sur une FACTURE. Modèle à part plutôt qu'un simple champ `montantPaye` :
// les règlements sont fractionnés en pratique (acompte à la commande puis solde), et l'état de
// la créance (payée / partielle / impayée / en retard) se DÉDUIT de la somme des paiements
// rapportée au TTC — il n'est jamais stocké, donc jamais désynchronisé (voir
// src/lib/facturation.ts, computeCreance).
//
// NB : `Projet.budgetEncaisse`, saisi à la main, fait doublon avec ces paiements dès qu'ils sont
// utilisés. Conservé tel quel pour l'instant — arbitrage à faire séparément.
model Paiement {
  id         String   @id @default(cuid())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  montant Decimal  @db.Decimal(14, 2)
  date    DateTime @default(now())
  methode String? // virement, chèque, espèces… texte libre, pas d'enum tant que l'usage n'est pas fixé
  notes   String?

  createdAt DateTime @default(now())

  @@map("paiements")
}

// Infos de Kinaya elle-même (le "prestataire" sur les devis/factures imprimés) — ligne unique,
// jamais pré-remplie avec de vraies données par le code : livrée vide, saisie une fois par
// l'admin via /parametres après déploiement (src/lib/agence-info.ts).
model AgenceInfo {
  id                 String  @id @default(cuid())
  // Pas de valeur par défaut : la dénomination sociale, le logo et les identifiants légaux
  // restent vides tant que l'admin ne les a pas saisis via /parametres — rien n'est affiché
  // tant que ce n'est pas rempli (décision explicite, pas d'espace réservé visible à vide).
  nom                String?
  logoUrl            String? // chemin de storage (ou lien externe), affiché en grand en pied de document imprimé
  adresse            String?
  email              String?
  telephone          String?
  nif                String?
  nis                String?
  rc                 String?
  ai                 String?
  banqueNom          String?
  rib                String?
  conditionsPaiement String? // texte libre, réutilisé tel quel sur chaque document imprimé

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agence_info")
}

model LigneDocument {
  id         String   @id @default(cuid())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  libelle      String
  quantite     Decimal @default(1) @db.Decimal(10, 2)
  prixUnitaire Decimal @db.Decimal(14, 2)
  ordre        Int     @default(0)

  @@map("lignes_document")
}

// ---------------------------------------------------------------------------
// Décision — nouvelle entité, priorité absolue (Livrable 03 §6)
// ---------------------------------------------------------------------------

model Decision {
  id              String   @id @default(cuid())
  intitule        String
  contexte        String?
  optionsEcartees String?
  justification   String
  date            DateTime @default(now())
  track           Track? // NULL = décision stratégique transverse (Livrable 06 §7)

  // Entité liée : Projet OU Client OU aucune — jamais les deux (contrainte XOR non native à
  // Prisma, à ajouter en SQL brut : CHECK (projet_id IS NULL OR client_id IS NULL)).
  projet   Projet?       @relation(fields: [projetId], references: [id])
  projetId String?
  client   Organisation? @relation(fields: [clientId], references: [id])
  clientId String?

  // Immutabilité : une Décision qui évolue devient une nouvelle Décision qui référence la
  // précédente (Livrable 03 §6) — non imposé au niveau du schéma, règle de la future Couche
  // Logique Métier.
  remplace     Decision? @relation("DecisionRevision", fields: [remplaceId], references: [id])
  remplaceId   String?   @unique
  remplaceePar Decision? @relation("DecisionRevision")

  createdAt DateTime @default(now())

  @@map("decisions")
}

// ---------------------------------------------------------------------------
// Note — ex-Concept (ADR-006 pt.4 implicite via ontologie §7)
// ---------------------------------------------------------------------------

model Note {
  id       String        @id @default(cuid())
  projet   Projet?       @relation(fields: [projetId], references: [id], onDelete: Cascade)
  projetId String?
  client   Organisation? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String?

  titre   String?
  contenu String
  tag     String? // tag libre — passage à String[] si besoin de multi-tags en usage réel

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Même remarque que Decision : contrainte XOR (projetId/clientId) à ajouter en SQL brut.

  @@map("notes")
}

// ---------------------------------------------------------------------------
// Actif Créatif (ex-Asset) — rattaché à Projet, plus à ProductionLabel (ADR-006 pt.2)
// ---------------------------------------------------------------------------
// NB : l'ontologie (Livrable 03 §8) classe "Actif Créatif" en Post-MVP dans sa forme complète
// (versionnement, portfolio). Ce modèle reprend la forme minimale de l'ancien Asset — stockage
// de fichier simple — nécessaire pour ne pas perdre les Asset existants lors de la fusion Label.
// Tension non résolue entre les deux : signalée, pas tranchée ici.

enum TypeAsset {
  IMAGE
  VIDEO
  SON
  DOC
}

model Asset {
  id       String @id @default(cuid())
  projet   Projet @relation(fields: [projetId], references: [id], onDelete: Cascade)
  projetId String

  type               TypeAsset
  nom                String
  url                String
  sourceGenerateurIa Boolean   @default(false) // crochet réservé : génération IA nodale, non implémentée

  // Distingue les images de référence (planche d'inspiration, montrée au client dans le portail)
  // des fichiers de production internes. Un drapeau plutôt qu'un modèle séparé : l'upload, la
  // résolution d'URL signée et la suppression sont exactement les mêmes, seule l'intention change.
  moodboard Boolean @default(false)
  // Légende libre affichée sous l'image du moodboard — la référence visuelle a souvent besoin
  // d'un mot d'explication ("direction lumière", "à éviter") que `nom` ne porte pas.
  legende   String?

  createdAt DateTime @default(now())

  @@index([projetId, moodboard])
  @@map("assets")
}

// ---------------------------------------------------------------------------
// Fournisseur — nouvelle entité, module Orbit (ADR-008)
// ---------------------------------------------------------------------------

// Spécialités métier Kinaya — liste fournie par le fondateur, AUTRE en soupape puisque la liste
// n'a pas été présentée comme exhaustive.
enum CategorieFournisseur {
  CINEMA
  MOTION
  WEB
  COPYWRITING
  PROJECT_MANAGEMENT
  AUTRE
}

model Fournisseur {
  id        String                @id @default(cuid())
  nom       String
  categorie CategorieFournisseur?
  contact   String?
  email     String?
  telephone String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Pas de relation à Projet en MVP — annuaire autonome, exclu explicitement (ADR-008).
  // À ajouter (relation many-to-many) si le besoin de traçabilité se confirme en usage réel.

  @@map("fournisseurs")
}

// ---------------------------------------------------------------------------
// Opérationnel — Tâche / Dépense (hors ontologie métier, jamais remis en cause)
// ---------------------------------------------------------------------------

enum StatutTache {
  A_FAIRE
  EN_COURS
  EN_PAUSE
  FAIT
}

// Priorité informelle plutôt qu'un P0-P3 : reflète le vocabulaire réel de l'équipe.
enum PrioriteTache {
  HIGH
  CHILL
  OSEF
}

model Tache {
  id String @id @default(cuid())

  // Rattachée à un Projet — ProductionLabel n'existant plus (fusionné), l'alternative de
  // rattachement de l'ancien schéma a disparu ; le champ redevient obligatoire.
  projet   Projet @relation(fields: [projetId], references: [id], onDelete: Cascade)
  projetId String

  libelle     String
  description String?
  statut      StatutTache   @default(A_FAIRE)
  priorite    PrioriteTache @default(CHILL)
  // `dateDebut` + `echeance` forment la plage affichée par la vue Timeline. Les deux restent
  // optionnelles : une tâche sans date de début est un simple point d'échéance sur la frise.
  dateDebut   DateTime?
  echeance    DateTime?

  assigneA   Utilisateur? @relation(fields: [assigneAId], references: [id])
  assigneAId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("taches")
}

model Depense {
  id String @id @default(cuid())

  // Rattachable à un Projet, ou générale (les deux cas déjà supportés par l'ancien schéma ;
  // ProductionLabel comme alternative a disparu avec la fusion).
  projet   Projet? @relation(fields: [projetId], references: [id], onDelete: Cascade)
  projetId String?

  categorie String
  montant   Decimal  @db.Decimal(14, 2)
  date      DateTime @default(now())
  notes     String?

  createdAt DateTime @default(now())

  @@map("depenses")
}
