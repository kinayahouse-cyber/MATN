// Matn — schéma de données (14 entités, cf. CLAUDE.md)
// Mono-devise DZD HT. Architecture mono-utilisateur, prête pour le multi-utilisateur.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth — mono-utilisateur pour l'instant, structuré pour accueillir plusieurs comptes.
// ---------------------------------------------------------------------------

model Utilisateur {
  id        String   @id @default(cuid())
  email     String   @unique
  nom       String?
  createdAt DateTime @default(now())

  tachesAssignees Tache[]

  @@map("utilisateurs")
}

// ---------------------------------------------------------------------------
// Monde commercial
// ---------------------------------------------------------------------------

enum TypeOrganisation {
  CLIENT_DIRECT
  AGENCE
  PRESCRIPTEUR
}

model Organisation {
  id     String           @id @default(cuid())
  nom    String
  type   TypeOrganisation @default(CLIENT_DIRECT)
  secteur String?

  // Identifiants légaux (Algérie)
  nif String?
  nis String?
  rc  String?
  ai  String?
  rib String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts      Contact[]
  opportunites  Opportunite[]
  projets       Projet[]

  @@map("organisations")
}

enum CanalContact {
  EMAIL
  TELEPHONE
  WHATSAPP
  AUTRE
}

enum Registre {
  TU
  VOUS
}

model Contact {
  id             String       @id @default(cuid())
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  organisationId String

  nom      String
  role     String?
  canal    CanalContact @default(EMAIL)
  registre Registre     @default(VOUS)
  email    String?
  telephone String?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contacts")
}

enum Division {
  STUDIO
  ATELIER
  LABEL
  GENERALITES
}

enum StatutPipeline {
  NOUVEAU
  QUALIFICATION
  PROPOSITION
  NEGOCIATION
  GAGNEE
  PERDUE
}

model Opportunite {
  id             String       @id @default(cuid())
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  organisationId String

  titre            String
  secteur          String?
  divisionPressentie Division?
  statut           StatutPipeline @default(NOUVEAU)
  valeurEstimee    Decimal?       @db.Decimal(14, 2)
  notes            String?

  // Se convertit en Projet si signée.
  projet   Projet? @relation(fields: [projetId], references: [id])
  projetId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("opportunites")
}

enum Engagement {
  LECTURE
  IDENTITE
  FILM
  EDITION
  CAPSULES
  MODULE_ATELIER
}

enum StadeProjet {
  CADRAGE
  PREPROD
  PRODUCTION
  LIVRAISON
  CLOTURE
}

model Projet {
  id   String @id @default(cuid())
  code String @unique // KIN-26-{S|A|L|G}-XXX

  nom  String
  division   Division
  engagement Engagement?
  stade      StadeProjet @default(CADRAGE)
  budget     Decimal?    @db.Decimal(14, 2)

  // Bornes indicatives pour la Timeline (Gantt) — cadrage → livraison.
  dateDebut     DateTime?
  dateFinPrevue DateTime?

  // Optionnel : projets internes/label n'ont pas forcément d'organisation cliente.
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  organisationId String?

  opportunite Opportunite?

  devis    Devis[]
  factures Facture[]
  concepts Concept[]
  taches   Tache[]
  depenses Depense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("projets")
}

enum StatutDevis {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
}

model Devis {
  id       String @id @default(cuid())
  projet   Projet @relation(fields: [projetId], references: [id], onDelete: Cascade)
  projetId String

  numero String      @unique
  statut StatutDevis @default(BROUILLON)
  // Avenant à un devis initial, le cas échéant.
  avenantDe   Devis?  @relation("Avenants", fields: [avenantDeId], references: [id])
  avenantDeId String?
  avenants    Devis[] @relation("Avenants")

  lignes LigneDevis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("devis")
}

model LigneDevis {
  id      String @id @default(cuid())
  devis   Devis  @relation(fields: [devisId], references: [id], onDelete: Cascade)
  devisId String

  libelle      String
  quantite     Decimal @default(1) @db.Decimal(10, 2)
  prixUnitaire Decimal @db.Decimal(14, 2)
  ordre        Int     @default(0)

  @@map("lignes_devis")
}

enum StatutFacture {
  EMISE
  PARTIELLEMENT_PAYEE
  PAYEE
  EN_RETARD
}

model Facture {
  id       String @id @default(cuid())
  projet   Projet @relation(fields: [projetId], references: [id], onDelete: Cascade)
  projetId String

  numero          String        @unique // FAC-AAAA-MM-NNN
  montant         Decimal       @db.Decimal(14, 2)
  statut          StatutFacture @default(EMISE)
  exonerationTva  Boolean       @default(true)
  dateEmission    DateTime      @default(now())
  dateEcheance    DateTime?

  paiements Paiement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("factures")
}

model Paiement {
  id        String  @id @default(cuid())
  facture   Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)
  factureId String

  montant Decimal  @db.Decimal(14, 2)
  date    DateTime @default(now())
  moyen   String?
  notes   String?

  createdAt DateTime @default(now())

  @@map("paiements")
}

// ---------------------------------------------------------------------------
// Monde label (autonome — aucun devis/facture/paiement)
// ---------------------------------------------------------------------------

enum StadeProductionLabel {
  DEVELOPPEMENT
  PREPROD
  PROD
  DISTRIBUTION
  ARCHIVE
}

model ProductionLabel {
  id   String @id @default(cuid())
  code String @unique // KIN-26-L-XXX

  titre           String
  format          String?
  budgetAlloue    Decimal?             @db.Decimal(14, 2)
  stadeProduction StadeProductionLabel @default(DEVELOPPEMENT)
  statutDiffusion String?

  sections SectionDossier[]
  assets   Asset[]
  taches   Tache[]
  depenses Depense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("productions_label")
}

enum TypeSectionDossier {
  NOTE_INTENTION
  PITCH
  REFERENCES
  TRAITEMENT
  SCRIPT
}

model SectionDossier {
  id                String          @id @default(cuid())
  production        ProductionLabel @relation(fields: [productionLabelId], references: [id], onDelete: Cascade)
  productionLabelId String

  type    TypeSectionDossier
  titre   String?
  contenu String?
  ordre   Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sections_dossier")
}

enum TypeAsset {
  IMAGE
  VIDEO
  SON
  DOC
}

model Asset {
  id                String          @id @default(cuid())
  production        ProductionLabel @relation(fields: [productionLabelId], references: [id], onDelete: Cascade)
  productionLabelId String

  type     TypeAsset
  nom      String
  url      String
  // Crochet réservé : réception depuis le générateur IA nodal (non implémenté).
  sourceGenerateurIa Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("assets")
}

// ---------------------------------------------------------------------------
// Transverses
// ---------------------------------------------------------------------------

model Concept {
  id       String @id @default(cuid())
  projet   Projet @relation(fields: [projetId], references: [id], onDelete: Cascade)
  projetId String

  titre   String?
  contenu String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("concepts")
}

enum StatutTache {
  A_FAIRE
  EN_COURS
  FAIT
}

model Tache {
  id String @id @default(cuid())

  // Rattachable à un Projet OU une ProductionLabel (jamais les deux).
  projet            Projet?          @relation(fields: [projetId], references: [id], onDelete: Cascade)
  projetId          String?
  production        ProductionLabel? @relation(fields: [productionLabelId], references: [id], onDelete: Cascade)
  productionLabelId String?

  libelle   String
  statut    StatutTache @default(A_FAIRE)
  echeance  DateTime?

  assigneA   Utilisateur? @relation(fields: [assigneAId], references: [id])
  assigneAId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("taches")
}

model Depense {
  id String @id @default(cuid())

  // Rattachable à un Projet, une ProductionLabel, ou générale (les deux null).
  projet            Projet?          @relation(fields: [projetId], references: [id], onDelete: Cascade)
  projetId          String?
  production        ProductionLabel? @relation(fields: [productionLabelId], references: [id], onDelete: Cascade)
  productionLabelId String?

  categorie String
  montant   Decimal  @db.Decimal(14, 2)
  date      DateTime @default(now())
  notes     String?

  createdAt DateTime @default(now())

  @@map("depenses")
}
