# MATN — variables d'environnement (EXEMPLE)
# Copier ce fichier en .env.local et remplir les vraies valeurs.
# .env.local ne doit JAMAIS être commité (voir .gitignore).
# Les mêmes variables se configurent aussi dans Vercel → Settings → Environment Variables.

# ---- Base de données (Supabase ou Neon) ----
# URL de connexion Postgres. Depuis le dashboard Supabase/Neon.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---- Supabase (si Supabase choisi pour base + auth + stockage) ----
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="votre-anon-key-publique"
# Clé service_role : SERVEUR UNIQUEMENT, jamais exposée au client, jamais préfixée NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY="votre-service-role-key-secrete"

# ---- Auth applicative (mot de passe simple + session) ----
# Mot de passe d'accès à l'app (mono-utilisateur pour l'instant).
AUTH_PASSWORD="change-moi"
# Secret de session (générer une chaîne aléatoire longue, ex: openssl rand -hex 32).
AUTH_SESSION_SECRET="chaine-aleatoire-longue-a-generer"

# ---- Vercel ----
# Le token Vercel (vcp_...) ne se met PAS ici et ne se commite JAMAIS.
# Il vit dans ta session `vercel login` locale, ou en variable d'env de ton shell
# au moment d'un déploiement CLI :  VERCEL_TOKEN=xxx vercel deploy
# En production, Vercel s'authentifie via le repo connecté, pas via un fichier.
